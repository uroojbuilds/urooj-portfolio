# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env or .env.local — both are already in .gitignore.
# On Netlify, set these under Site settings → Environment variables instead.

# Neon Postgres connection string (Drizzle reads this to talk to the database).
# Example shape only — get the real one from your Neon project dashboard:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Auth.js session encryption secret. Generate a real one with:
#   npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=

# GitHub OAuth App credentials (create one at
# https://github.com/settings/developers — callback URL should be
# https://<your-domain>/api/auth/callback/github, and
# http://localhost:3000/api/auth/callback/github for local dev).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The exact email address on the GitHub account allowed to sign in as admin.
# Sign-in is rejected for every other GitHub account, even a valid OAuth login.
ADMIN_EMAIL=

# Personal access token used ONLY server-side, by the admin-only GitHub
# repository discovery workflow (Phase 10) — never sent to the browser.
# A fine-grained token with public-repo read access is enough; no scopes
# needed beyond reading public repository metadata. Optional: discovery
# still works unauthenticated at GitHub's much lower unauthenticated rate
# limit if this is left blank, but a token is strongly recommended.
GITHUB_TOKEN=

# GitHub username/owner whose public repositories the admin discovery page
# lists. Optional — if unset, it's parsed from profile.social.github in
# data/profile.ts instead, so you likely don't need to set this separately.
GITHUB_OWNER=
